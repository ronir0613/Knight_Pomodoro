{
  "manifest_version": 3,
  "name": "Knight Pomodoro",
  "version": "1.0.0",
  "description": "Track your Pomodoro time versus unfocused browser time.",
  "action": {
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/floating-timer.tsx"]
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "tabs",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle_timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Start, Pause, or Resume the timer"
    },
    "skip_phase": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "Command+Shift+Right"
      },
      "description": "Skip the current phase"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}

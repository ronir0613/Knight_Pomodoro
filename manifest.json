{
  "manifest_version": 3,
  "name": "Knight Pomodoro",
  "version": "1.0.0",
  "description": "Track your Pomodoro time versus unfocused browser time.",
  "action": {
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/floating-timer.tsx"]
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
